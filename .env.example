# ProvenOps Environment Configuration Example
# Copy this file to .env for custom local deployments: cp .env.example .env

# ==============================================================================
# Control Plane Database
# ==============================================================================
PROVENOPS_DATABASE_URL=postgres://opspilot:opspilot_dev_secret@localhost:5432/opspilot?sslmode=disable
DB_USER=opspilot
DB_PASSWORD=opspilot_dev_secret
DB_NAME=opspilot
DB_PORT=5432

# ==============================================================================
# Control Plane Ports & API
# ==============================================================================
PROVENOPS_HTTP_PORT=8080
PROVENOPS_GRPC_PORT=9090

# ==============================================================================
# Security & Authentication
# CRITICAL: In production, change JWT_SECRET (min 32 bytes) and generate unique BOOTSTRAP_TOKEN.
# ==============================================================================
PROVENOPS_JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_bytes
PROVENOPS_BOOTSTRAP_TOKEN=provenops-default-bootstrap-token-2026
PROVENOPS_ENVIRONMENT=development

# ==============================================================================
# AI Service Configuration
# ==============================================================================
PROVENOPS_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=qwen2.5:3b
ENABLE_HEURISTIC_FALLBACK=true

# ==============================================================================
# Server Agent Configuration (Used by Agent Binary)
# ==============================================================================
PROVENOPS_CONTROL_PLANE_ADDR=localhost:9090
PROVENOPS_BOOTSTRAP_TOKEN=provenops-default-bootstrap-token-2026
PROVENOPS_HEARTBEAT_INTERVAL_SEC=5
PROVENOPS_TLS_ENABLED=true

# ==============================================================================
# Dashboard
# ==============================================================================
DASHBOARD_PORT=3000
VITE_API_URL=http://localhost:8080

# ==============================================================================
# Backward Compatibility Fallbacks (Supported alongside PROVENOPS_*)
# Priority: PROVENOPS_* > OPSPILOT_* > generic
# ==============================================================================
# OPSPILOT_DATABASE_URL=postgres://opspilot:opspilot_dev_secret@localhost:5432/opspilot?sslmode=disable
# OPSPILOT_BOOTSTRAP_TOKEN=provenops-default-bootstrap-token-2026
