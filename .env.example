# OpsPilot Environment Configuration Example

# Control Plane Database
DATABASE_URL=postgres://opspilot:opspilot_dev_secret@localhost:5432/opspilot?sslmode=disable
DB_USER=opspilot
DB_PASSWORD=opspilot_dev_secret
DB_NAME=opspilot
DB_PORT=5432

# Control Plane Ports
CONTROL_PLANE_HTTP_PORT=8080
CONTROL_PLANE_GRPC_PORT=9090

# Security & Authentication
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_bytes
JWT_EXPIRATION_HOURS=24
BOOTSTRAP_TOKEN=opspilot-default-bootstrap-token-2026

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=qwen2.5:3b

# Agent Configuration (Used by Agent Binary)
AGENT_CONTROL_PLANE_ADDR=localhost:9090
AGENT_BOOTSTRAP_TOKEN=opspilot-default-bootstrap-token-2026
AGENT_HEARTBEAT_INTERVAL_SEC=5
AGENT_ENVIRONMENT=development

# Dashboard
DASHBOARD_PORT=3000
VITE_API_URL=http://localhost:8080
